# CareerDNA Environment Configuration

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# For local zero-config development: file:./dev.db
# For Supabase / PostgreSQL production:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true"
DATABASE_URL="file:./dev.db"

# -------------------------------------------------------------
# Qloo Cultural AI / Taste Intelligence Layer
# -------------------------------------------------------------
# Obtain your API key at https://docs.qloo.com / developer portal
# Note: If no key is provided, CareerDNA automatically runs in
# high-accuracy Degraded Local Fallback Mode without breaking!
QLOO_API_KEY="ql_test_demo_key_here"
QLOO_API_BASE_URL="https://api.qloo.com/v1"

# -------------------------------------------------------------
# LLM / Agent Orchestrator Configuration
# -------------------------------------------------------------
# Supported providers: "gemini" | "openai" | "anthropic" | "mock"
LLM_PROVIDER="gemini"
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="gemini-1.5-pro"

# -------------------------------------------------------------
# Tambo Generative UI Layer (Self-Hosted / Open-Source Setup)
# -------------------------------------------------------------
# Since Tambo Cloud is shutting down, CareerDNA includes a built-in
# open-source agentic generative-UI runtime and endpoints:
NEXT_PUBLIC_TAMBO_MODE="self-hosted"
NEXT_PUBLIC_TAMBO_ENDPOINT="/api/agent/chat"
NEXT_PUBLIC_TAMBO_API_KEY="careerdna-local-key"

# -------------------------------------------------------------
# Application & Authentication
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="careerdna-super-secret-key-32-chars-long-demo"
AUTH_DEMO_MODE="true"
